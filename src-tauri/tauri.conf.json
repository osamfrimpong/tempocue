{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TempoCue",
  "version": "0.1.0",
  "identifier": "com.tempocue.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TempoCue",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "url": "/control"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "fileAssociations": [
      {
        "ext": ["tmpc"],
        "name": "TempoCue Schedule",
        "description": "TempoCue encoded schedule",
        "mimeType": "application/x-tempocue-schedule",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.tempocue.app.schedule",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
